---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Haitao 👋</h1>
			<p>
				I invest in technology by day, and build it with a team of AI agents by night.
				Investor at <a href="https://www.linear.vc">Linear Capital</a>; programming and
				product-making are my lifelong hobbies.
			</p>
			<p>
				This blog collects my notes on products, agents, and the ideas I can't stop
				thinking about. Start with the <a href="/blog/blog/">posts</a>, or read
				<a href="/blog/about/">about me</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
